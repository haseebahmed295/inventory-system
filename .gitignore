# ==============================================================================
# Git Ignore for JavaFX Inventory Management System (SE-314 OEL)
# ==============================================================================

# Compiled Class files
*.class

# Package Files (except bundled JavaFX runtime in lib/)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!lib/*.jar

# Build output directories
target/
bin/
build/
out/
.gradle/

# Log files
*.log

# IDE & Editor metadata
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
